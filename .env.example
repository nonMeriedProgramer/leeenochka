# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # для Whisper (розпізнавання голосу)
# Gemini (Nano Banana) — картинка ранкового брифу. Ключ з https://aistudio.google.com/apikey
# Без ключа бриф просто йде текстом (без картинки).
GEMINI_API_KEY=

# Apple Calendar (iCloud CalDAV)
# Пароль — App-Specific Password з appleid.apple.com
APPLE_ID_EMAIL=
APPLE_APP_PASSWORD=

# Notion
NOTION_API_KEY=
NOTION_TASKS_DB_ID=

# Iterate (Supabase)
ITERATE_SUPABASE_URL=
ITERATE_SUPABASE_SERVICE_KEY=

# Postgres (db/index.ts) — на Railway/Render зазвичай приходить з платформи,
# тоді тут можна лишити порожнім. Локально або для tools/garmin_sync.py
# скопіюй той самий рядок підключення, що бачить бот.
DATABASE_URL=

# Живий дашборд тренувань: GET /dashboard?token=<це значення>
DASHBOARD_SECRET=

# Автопост тренувань у канал «gym table» (опційно — без цього просто не постить).
# 1) Додай бота адміном каналу з правом "Post Messages".
# 2) Дізнайся chat id каналу: перешли будь-який пост з каналу в @userinfobot,
#    або тимчасово додай лог у channel_post-хендлері й подивись ctx.chat.id.
#    Для каналів id зазвичай від'ємний, напр. -1001234567890.
GYM_CHANNEL_ID=

PORT=3001
