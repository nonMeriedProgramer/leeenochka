# Telegram
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # для Whisper (розпізнавання голосу)
# Картинка ранкового брифу малюється кодом (satori→PNG, шрифти в assets/fonts) —
# жодного ключа чи оплати не потрібно.

# Intervals.icu — джерело даних Garmin: wellness (сон, HRV, пульс спокою, кроки,
# стрес) для ранкового брифу, і тренування (біг/вело/бокс/зала — з підходами й
# вагою з оригінального FIT) для автопосту в «gym table» о 21:00 + MCP для claude.ai.
# 1) intervals.icu → Settings → Connections → Garmin Connect (підтвердити доступ,
#    увімкнути «Download activities»)
# 2) Settings → Developer Settings → API key
# Без ключа обидві фічі просто вимкнені. Перевірка тренувань: /training_preview.
INTERVALS_API_KEY=
# Опційно: ID атлета (i123456). Без нього береться власник ключа ("0").
INTERVALS_ATHLETE_ID=

# Apple Calendar (iCloud CalDAV)
# Пароль — App-Specific Password з appleid.apple.com
APPLE_ID_EMAIL=
APPLE_APP_PASSWORD=

# Notion
NOTION_API_KEY=
NOTION_TASKS_DB_ID=

# Iterate (Supabase)
ITERATE_SUPABASE_URL=
ITERATE_SUPABASE_SERVICE_KEY=

# Postgres (db/index.ts) — на Railway/Render зазвичай приходить з платформи,
# тоді тут можна лишити порожнім. Локально або для tools/garmin_sync.py
# скопіюй той самий рядок підключення, що бачить бот.
DATABASE_URL=

# Живий дашборд тренувань: GET /dashboard?token=<це значення>
DASHBOARD_SECRET=

# Автопост тренувань у канал «gym table» (опційно — без цього просто не постить).
# 1) Додай бота адміном каналу з правом "Post Messages".
# 2) Дізнайся chat id каналу: перешли будь-який пост з каналу в @userinfobot,
#    або тимчасово додай лог у channel_post-хендлері й подивись ctx.chat.id.
#    Для каналів id зазвичай від'ємний, напр. -1001234567890.
GYM_CHANNEL_ID=

# MCP для claude.ai (веб/телефон) — читає тренування й wellness через
# Customize → Connectors. claude.ai для кастомного конектора приймає тільки
# URL (без окремого поля токена), тому секрет — прямо в шляху:
# https://<APP_URL>/mcp/<MCP_SECRET>. Будь-який довгий випадковий рядок,
# напр. `openssl rand -hex 32`. Команда в боті: /mcp_url (тільки в приваті).
MCP_SECRET=

PORT=3001
